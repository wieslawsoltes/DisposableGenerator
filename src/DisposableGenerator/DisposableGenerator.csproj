<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>DisposableGenerator</AssemblyName>
    <RootNamespace>DisposableGenerator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageId>DisposableGenerator</PackageId>
    <PackageType>Analyzer</PackageType>
    <Title>DisposableGenerator</Title>
    <Description>An incremental C# source generator for explicit, inheritance-safe IDisposable and IAsyncDisposable ownership.</Description>
    <PackageTags>csharp source-generator roslyn idisposable iasyncdisposable dispose analyzer finalizer</PackageTags>
    <PackageProjectUrl>https://github.com/wieslawsoltes/DisposableGenerator</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/wieslawsoltes/DisposableGenerator/blob/v$(VersionPrefix)/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/DisposableGenerator.props" Pack="true" PackagePath="buildTransitive/DisposableGenerator.props" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
